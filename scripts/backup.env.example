# Copy this file to scripts/backup.env and fill it in.
# scripts/backup.env is gitignored — it holds secrets. Never commit it.

# SSH target for your Coolify VPS, e.g. "root@203.0.113.10".
# Anything that works for `ssh <this>` works here (including Host aliases
# from ~/.ssh/config).
VPS_SSH=""

# The production Neon connection string — the same value as DATABASE_URI in
# the Coolify app's environment variables. Keep ?sslmode=require if present.
PROD_DATABASE_URI=""

# Where uploaded media lives on the VPS — set ONE of these two:
#
# MEDIA_VOLUME: the Docker volume name Coolify created for /app/media.
#   Find it with:   ssh <your-vps> docker volume ls
#   (or Coolify UI → your app → Persistent Storage)
MEDIA_VOLUME=""
#
# MEDIA_PATH: or, if Coolify mounts a host directory instead of a named
# volume, its absolute path on the VPS.
MEDIA_PATH=""

# Postgres client image used to run pg_dump / pg_restore on the VPS.
# Its major version must be >= your Neon Postgres version (shown in the
# Neon dashboard). Default: postgres:17-alpine
#PG_IMAGE="postgres:17-alpine"
